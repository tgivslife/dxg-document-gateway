# Store text files with LF, and check them out with LF on every platform.
# Scripts, Compose files and .env files run or are parsed in Linux containers,
# where CRLF breaks shebangs and adds \r to values.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Mail samples must stay byte for byte: RFC 5322 uses CRLF, and the
# intake checks SHA-256 hashes. Never convert their line endings.
*.eml -text

# Binary files: no line-ending conversion and no text diffs
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tif binary
*.tiff binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.odt binary
*.ods binary
*.der binary
*.p12 binary
*.pfx binary
*.p7s binary
*.cms binary
